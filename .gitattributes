# Keep Unix line endings everywhere, except Windows batch files.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.go text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Binaries / archives: never let git mangle them.
*.png binary
*.ico binary
*.icns binary
*.apk binary
*.aab binary
*.aar binary
*.deb binary
*.rpm binary
*.AppImage binary
*.tar.gz binary
*.zip binary
